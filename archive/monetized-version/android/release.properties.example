# Owner confirmed children under 13 and older players. Complete Families declarations.
targetAudience=mixed
# Absolute path or path relative to android/. Keep the key outside the repository.
uploadStoreFile=
uploadKeyAlias=
# Passwords belong in environment variables BLOCKBLOCK_STORE_PASSWORD / BLOCKBLOCK_KEY_PASSWORD.
